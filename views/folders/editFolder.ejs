<%- include('../partials/head'), {title: "Edit Folder"} %>
<h1>Edit Folder</h1>
<% if (locals.errors) { %>
    <ul style="color: red;">
    <% error.forEach(error => { %>
        <li><%= error.msg %></li>
    <% }) %>
    </ul>
<% } %>

<form action="/folders/<%= folder.id %>" method="post">
    <label for="name">Folder Name</label>
    <input type="text" name="name" id="name" value="<%= folder.name %>">
    <button type="submit">Save</button>
</form>

<%- include('../partials/footer') %>