<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <h1>My Folders</h1>
    <a href="/folders/new"><button>New Folder</button></a>
    <ul>
        <% folders.forEach(folder => { %>
            <li><a href="/folders/<%= folder.id %>"><%= folder.name %></a></li>
        <% }) %>
    </ul>
    <a href="/">Back home</a>
</body>
</html>