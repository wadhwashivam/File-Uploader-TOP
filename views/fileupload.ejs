<%- include('partials/head'), {title: 'Home'} %>

<div class="flex flex-col justify-center items-center shadow-xl/20 rounded-xl pb-10 max-w-400 pt-10">
<h1 class="text-2xl">Upload a file</h1>
<form action="/fileupload" method="post" enctype="multipart/form-data">
    <% if (locals.errors) { %>
        <ul style="color: red;">
            <% errors.forEach(error => { %>
                <li><% error.msg %></li>
            <% }) %>
        </ul>
    <% } %>
    
    <label for="folderId" class="text-base font-semibold">Save to folder (optional)</label>
    <select name="folderId" id="folderId" class="mb-2.5 mt-2.5">
        <option value="" <%= !selectedFolderId ? "selected" : "" %>>No Folder</option>
        <% folders.forEach(folder => { %>
            <option value="<%= folder.id %>" <%= selectedFolderId === folder.id ? "selected" : "" %>>
                <%= folder.name %>
            </option>
        <% }) %>
    </select>
    <br>

    <input type="file" name="file" id="file" class="file-input">
    <br>
    <button type="submit" class="btn btn-soft btn-success ml-25 mt-5">Upload</button>
</form>

</div>
<%- include('partials/footer') %>