<%- include('../partials/head'), {title: "Folder Detail"} %>
<div class="flex flex-col justify-center items-center shadow-xl/20 rounded-xl pb-10 max-w-400 pt-10">

<h1 class="text-3xl font-semibold"><%= folder.name %></h1>
<div class="flex-row pt-3 pb-3">
<a href="/folders/<%= folder.id %>/edit"><button class="btn btn-soft btn-primary">Rename</button></a>
<a href="/fileupload?folderId=<%= folder.id %>"><button class="btn btn-soft btn-accent">Upload file here</button></a>
<form action="/folders/<%= folder.id %>/delete" method="post" style="display: inline;">
    <button type="submit" class="btn btn-soft btn-error">Delete Folder</button>
</form>
</div>


<h2>Files</h2>
<ul>
    <% folder.files.forEach(file => { %>
        <li>
        <a href="/files/<%= file.id %>"><%= file.filename %></a>
        <a href="/files/<%= file.id %>/download">⬇</a>
    </li>
    <% }) %>
</ul>

<a href="/folders" class="text-blue-600 dark:text-sky-400 mt-10 underline">Back to folders</a>
</div>

<%- include('../partials/footer') %>